# ============================================================================
# Docker build-context exclusions
# ============================================================================
# The build context is the monorepo root for every service, so keeping it lean
# is the single biggest win for build speed and image reproducibility.
# Only source, package manifests and the lockfile need to reach the daemon.
# ============================================================================

# Dependencies (reinstalled inside the image from the lockfile)
**/node_modules
.npm
.pnp
.pnp.js

# Build outputs (rebuilt inside the image)
**/dist
**/build
**/*.tsbuildinfo

# Python
**/__pycache__
**/*.pyc
**/*.pyo
.venv
venv
ENV
env
*.egg-info

# Version control / CI
.git
.gitignore
.gitattributes
.github

# Local environment / secrets (never bake into an image)
.env
.env.*
!.env.example
!.env.production.example

# Editor / OS cruft
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Tests & coverage
coverage
.nyc_output

# Logs
logs
*.log

# Project documentation & reports (huge, not needed at runtime)
*.md
!README.md
docs

# Docker / compose (not needed inside an image)
docker-compose*.yml
**/Dockerfile
.dockerignore

# Misc
.cache
.temp
Makefile
