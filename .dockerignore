# Keep the build context tiny — only source, manifests and config are needed.

# Secrets & local state (must never land in an image layer)
.env
.env.*
!.env.example
.secret.key
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
data/

# Python artefacts
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# VCS / CI / editors
.git
.gitignore
.github
.vscode
.idea
*.swp

# Docs & docker files themselves
*.md
!README.md
Dockerfile
docker-compose*.yml
.dockerignore
