# ============================================================================
# DeathBot environment configuration — copy to .env and fill in
# ============================================================================

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=123456:REPLACE_ME
# Telegram user id of the owner (full override, cannot be locked out)
OWNER_ID=0

# --- Runtime ----------------------------------------------------------------
DEATHBOT_ENV=development
LOG_LEVEL=INFO
# Where state is kept. Leave BOTH commented out — running from source they
# default to the project directory, and in Docker compose pins them to the
# /data volume. Setting them here would override the container defaults and
# push state into the read-only image.
# DATABASE_PATH=deathbot.sqlite3
# SECRET_KEY_FILE=.secret.key

# Optional 32-byte key (base64/hex/raw). If empty, a key file is generated at
# SECRET_KEY_FILE. Losing it makes every stored API key undecryptable.
SECRET_KEY=

# --- AI providers (all optional; the router degrades gracefully) ------------
# Every provider has ITS OWN default model — OpenRouter uses vendor-prefixed
# slugs ("openai/gpt-4o-mini") that are invalid on the other providers' own
# APIs, so don't copy one model name across providers. Override with the
# *_MODEL vars below only if you want something other than the default.
#
# Tip: users can also add their OWN key per-provider from inside the bot
# (⚙️ Настройки → ➕ Добавить ключ, id = openai/openrouter/groq/deepseek/grok/
# claude/gemini) — that takes priority over the values here and needs no
# restart.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-3-5-sonnet-latest
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
GROK_API_KEY=
# GROK_MODEL=grok-2-latest

# Local / self-hosted runtimes — OFF by default (empty base URL). Uncomment
# and set the URL to opt in; otherwise they are silently skipped, not attempted.
# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# ANYTHINGLLM_API_KEY=
# ANYTHINGLLM_BASE_URL=http://localhost:3001/api/v1/openai

# --- OSINT / recon API keys (optional) --------------------------------------
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=
HUNTER_API_KEY=
SECURITYTRAILS_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
# Leak aggregator: free sources (LeakCheck public, Hudson Rock Cavalier) are
# always on. Set this ONLY if you hold a legitimate Dehashed account — it is
# never enabled by default.
DEHASHED_API_KEY=
