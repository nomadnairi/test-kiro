# Application
NODE_ENV=development
APP_NAME=CyberIntel Platform
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://cyberintel:cyberintel@localhost:5432/cyberintel
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cyberintel
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
SESSION_SECRET=your-session-secret

# API Gateway
GATEWAY_PORT=8000
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100

# Backend Services
BACKEND_PORT=8001
ORCHESTRATOR_PORT=8002
AI_ROUTER_PORT=8003
GRAPH_ENGINE_PORT=8004

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_URL=http://localhost:11434

# AI Configuration
DEFAULT_AI_PROVIDER=ollama
AI_MODEL=llama3.1:8b
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# OSINT API Keys
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
URLSCAN_API_KEY=
SECURITYTRAILS_API_KEY=
GREYNOISE_API_KEY=
ALIENVAULT_API_KEY=
THREATFOX_API_KEY=

# Worker Configuration
WORKER_CONCURRENCY=5
QUEUE_NAME=cyberintel-tasks
MAX_RETRIES=3

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
CORS_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_AUDIT_LOG=true

# Feature Flags
ENABLE_GRAPH_ANALYSIS=true
ENABLE_AUTO_RECON=true
ENABLE_AI_AGENTS=true
ENABLE_WEBSOCKETS=true

# Performance
CACHE_TTL=3600
MAX_CONCURRENT_SCANS=10
REQUEST_TIMEOUT=30000

# Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9090
