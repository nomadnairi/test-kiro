# ============================================================================
# DeathBot environment configuration — copy to .env and fill in
# ============================================================================

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=123456:REPLACE_ME
# Telegram user id of the owner (full override, cannot be locked out)
OWNER_ID=0

# --- Runtime ----------------------------------------------------------------
DEATHBOT_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=deathbot.sqlite3
# 32-byte key (base64 or hex or raw). If unset, a key file is generated.
SECRET_KEY=

# --- AI providers (all optional; the router degrades gracefully) ------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Local runtimes
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- OSINT / recon API keys (optional) --------------------------------------
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=
HUNTER_API_KEY=
SECURITYTRAILS_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
