# Production Environment Configuration

# Application
NODE_ENV=production
APP_NAME=CyberIntel Platform
APP_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# Security - CHANGE THESE!
JWT_SECRET=CHANGE-THIS-TO-A-STRONG-RANDOM-SECRET
SESSION_SECRET=CHANGE-THIS-TO-A-STRONG-RANDOM-SECRET
POSTGRES_PASSWORD=CHANGE-THIS-STRONG-PASSWORD
NEO4J_PASSWORD=CHANGE-THIS-STRONG-PASSWORD
REDIS_PASSWORD=CHANGE-THIS-STRONG-PASSWORD
ELASTIC_PASSWORD=CHANGE-THIS-STRONG-PASSWORD

# Database
DATABASE_URL=postgresql://cyberintel:${POSTGRES_PASSWORD}@postgres:5432/cyberintel
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
ELASTICSEARCH_URL=http://elasticsearch:9200

# API Keys
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
URLSCAN_API_KEY=
SECURITYTRAILS_API_KEY=
GREYNOISE_API_KEY=
ALIENVAULT_API_KEY=

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Performance
WORKER_CONCURRENCY=10
MAX_CONCURRENT_SCANS=50

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
