# NOTE: `workspaces=true` is intentionally NOT set here.
# It makes every `npm run <script>` fan out to ALL workspaces, which breaks
# lifecycle scripts like `postinstall -> build:shared` (workspaces that lack
# the script abort the whole install). `npm install` already installs every
# workspace by default; targeted builds use `--workspace=<name>` explicitly.

# Automatically install peer dependencies
legacy-peer-deps=false

# Save exact versions
save-exact=true

# Engine strict mode
engine-strict=true

# Progress bar
progress=true

# Audit level
audit-level=moderate

# Fund messages
fund=false

# Update notifier
update-notifier=true
