{
  "name": "cyberintel-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Cyber Intelligence Platform with OSINT, Threat Intelligence, and Graph Analytics",
  "keywords": [
    "osint",
    "cybersecurity",
    "threat-intelligence",
    "ai",
    "reconnaissance",
    "graph-database",
    "neo4j",
    "security",
    "intelligence",
    "automation"
  ],
  "author": "CyberIntel Platform Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/cyberintel-platform.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/cyberintel-platform/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/cyberintel-platform#readme",
  "workspaces": [
    "frontend",
    "backend",
    "gateway",
    "orchestrator",
    "agents",
    "workers",
    "integrations",
    "graph-engine",
    "ai-router",
    "auth",
    "shared"
  ],
  "scripts": {
    "postinstall": "npm run build:shared",
    "build:shared": "npm run build --workspace=shared",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:gateway\" \"npm run dev:orchestrator\"",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:gateway\" \"npm run dev:orchestrator\" \"npm run dev:graph\" \"npm run dev:ai-router\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:gateway": "npm run dev --workspace=gateway",
    "dev:orchestrator": "npm run dev --workspace=orchestrator",
    "dev:graph": "npm run dev --workspace=graph-engine",
    "dev:ai-router": "npm run dev --workspace=ai-router",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "install:all": "npm install && npm run setup:python",
    "setup:python": "cd agents && pip install -r requirements.txt && cd ../workers && pip install -r requirements.txt",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:restart": "docker-compose restart",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "migrate": "npm run migrate --workspace=backend",
    "migrate:create": "npm run migrate:create --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "db:reset": "npm run docker:down && npm run docker:up && sleep 10 && npm run migrate && npm run seed",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "clean:all": "npm run clean && docker-compose down -v",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepare": "npm run build:shared"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
